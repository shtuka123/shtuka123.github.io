---
import type { ResearchItem } from '../data/research';
import TagList from './TagList.astro';

interface Props {
  item: Omit<ResearchItem, 'year' | 'abstract'> & Partial<Pick<ResearchItem, 'year' | 'abstract'>>;
}
const { item } = Astro.props;
const date = item.date ?? item.year;
---
<article class="research-entry">
  <details>
    <summary>{item.title}</summary>
    <div class="research-abstract">
      <p>{item.abstract && <strong>Abstract. </strong>}{item.abstract ?? item.description}</p>
    </div>
  </details>
  <div class="research-meta">
    <span>{item.venue ? `${item.venue}${date ? `(${date})` : ''}` : date}</span>
    <TagList tags={item.tags} />
    {item.links.map((link) => <a href={link.url}>{link.name}</a>)}
  </div>
</article>

<style>
  .research-entry { margin: 18px 0 22px; line-height: 1.55; }
  summary { cursor: pointer; list-style: none; font-size: 18px; }
  summary::-webkit-details-marker { display: none; }
  .research-abstract { margin: 6px 0 10px 18px; max-width: 850px; }
  .research-abstract p { margin: 6px 0; }
  .research-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-top: 4px; font-size: 14px; color: #555; }
  .research-meta :global(.post-tags) { display: flex; flex-wrap: wrap; gap: 6px 12px; }
  .research-meta :global(.tag) { font-family: monospace; font-size: 12px; }
  @media (max-width: 700px) {
    summary { font-size: 17px; }
  }
</style>
