---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { longDate } from '../lib/format';
import '../styles/blog.css';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const abstract = post.data.abstract || post.data.description;
---
<article class="blog-entry">
  <details>
    <summary>{post.data.title}</summary>
    <div class="blog-entry-abstract">
      {abstract && <p><strong>Abstract.</strong> {abstract}</p>}
    </div>
  </details>
  <div class="blog-entry-meta">
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{longDate(post.data.date)}</time>
    <TagList tags={post.data.tags} />
    <a href={`/blog/${post.id}/`}>Read post <span aria-hidden="true">→</span></a>
  </div>
</article>
