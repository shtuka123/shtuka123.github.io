---
import AcademicLayout from '../../layouts/AcademicLayout.astro';
import CourseEntry from '../../components/CourseEntry.astro';
import { teaching } from '../../data/teaching';
---
<AcademicLayout title="Teaching" section="teaching">
  <header class="page-heading"><h1 class="underline yellow">Teaching</h1> <span class="teaching-hint">Click a course to show/hide its description.</span></header>
  <p>Current and past teaching.</p>
  <div class="teaching-summary">{teaching.map((item) => <CourseEntry item={item} />)}</div>
</AcademicLayout>
