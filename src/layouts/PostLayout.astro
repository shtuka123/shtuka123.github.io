---
import AcademicLayout from './AcademicLayout.astro';
import TagList from '../components/TagList.astro';
import { longDate } from '../lib/format';
import '../styles/blog.css';

const { title, date, description, abstract, tags = [] } = Astro.props;
---

<AcademicLayout title={title} description={description} section="blog" math showHeader={false}>
  <article class="post-content">
    <header class="post-header">
      <a class="post-back" href="/#blog">← Back</a>
      <h1>{title}</h1>
      <div class="blog-entry-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>
        <TagList tags={tags} />
      </div>
      {abstract && <div class="post-abstract"><p><strong>Abstract.</strong> {abstract}</p></div>}
    </header>
    <slot />
  </article>
</AcademicLayout>
