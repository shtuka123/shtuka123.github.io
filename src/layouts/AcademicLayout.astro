---
import { site } from '../data/site';
import MathJax from '../components/MathJax.astro';
import '../styles/academic.css';

interface Props {
  title?: string;
  section?: string;
  home?: boolean;
  description?: string;
  math?: boolean;
  showHeader?: boolean;
}
const { title = site.title, section = 'home', home = false, description = site.description, math = false, showHeader = true } = Astro.props;
const nav = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'research', label: 'Research', href: '/#research' },
  { key: 'expository-writing', label: 'Expository Writing', href: '/#expository-writing' },
  ...(site.blogVisible ? [{ key: 'blog', label: 'Blog', href: '/#blog' }] : []),
  { key: 'talks', label: 'Talks', href: '/#talks' },
  { key: 'teaching', label: 'Teaching', href: '/#teaching' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === site.title ? title : `${title} — ${site.title}`}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
    {site.blogVisible && <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/feed.xml" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-pochacco.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      {showHeader && <header class="site-header">
        {home ? <h1 class="site-title">{site.title}</h1> : <p class="site-title"><a href="/">{site.title}</a></p>}
        {!home && <nav aria-label="Main navigation">{nav.map((item, i) => <Fragment>{i > 0 && <span aria-hidden="true"> · </span>}<a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a></Fragment>)}</nav>}
      </header>}
      <main id="main" tabindex="-1" class={home ? 'home' : undefined}><slot /></main>
    </div>
    {math && <MathJax />}
  </body>
</html>
